		"posts": [
			{
				"id": "post-1",
				"slug": "panduan-lengkap-python-untuk-pemula",
				"status": "published",
				"data": {
					"title": "Panduan Lengkap Belajar Python dari Dasar untuk Pemula",
					"excerpt": "Pelajari dasar-dasar pemrograman Python mulai dari variabel, struktur data dasar, hingga logika percabangan untuk pemula.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Python merupakan salah satu bahasa pemrograman paling populer dan ramah pemula di dunia saat ini. Sintaksnya yang bersih dan mudah dibaca membuat proses belajar coding menjadi jauh lebih menyenangkan.",
									"_key": "p1-c1"
								}
							],
							"_key": "p1-b1"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Mengapa Memilih Python?",
									"_key": "p1-c2"
								}
							],
							"_key": "p1-b2"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Selain sintaksnya yang sederhana, Python memiliki ekosistem pustaka (library) yang sangat luas. Anda dapat menggunakannya untuk web development, otomatisasi script, data science, hingga machine learning.",
									"_key": "p1-c3"
								}
							],
							"_key": "p1-b3"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Langkah Awal Menulis Kode",
									"_key": "p1-c4"
								}
							],
							"_key": "p1-b4"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Mulailah dengan memahami tipe data dasar seperti integer, float, string, serta boolean. Setelah itu, pelajari manipulasi list dan dictionary sebelum beralih ke pembuatan fungsi sendiri.",
									"_key": "p1-c5"
								}
							],
							"_key": "p1-b5"
						}
					]
				},
				"bylines": [
					{
						"byline": "byline-editorial"
					}
				],
				"taxonomies": {
					"category": [
						"python"
					],
					"tag": [
						"tutorial",
						"pemula"
					]
				}
			},
			{
				"id": "post-2",
				"slug": "membangun-web-modern-dengan-frontend-framework",
				"status": "published",
				"data": {
					"title": "Membangun Web Modern: Arsitektur Frontend dan Best Practices",
					"excerpt": "Eksplorasi strategi arsitektur modern dalam web development menggunakan TypeScript, arsitektur berbasis komponen, dan optimasi performa.",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Perkembangan ekosistem pengembangan web modern menuntut kita untuk membangun antarmuka yang cepat, mudah dipelihara, dan dapat diandalkan oleh pengguna di berbagai perangkat.",
									"_key": "p2-c1"
								}
							],
							"_key": "p2-b1"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Kekuatan TypeScript dalam Skala Besar",
									"_key": "p2-c2"
								}
							],
							"_key": "p2-b2"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Penggunaan TypeScript memastikan tipe data terdefinisi secara ketat, meminimalkan potensi runtime bugs, serta memberikan pengalaman developer (DX) yang jauh lebih mulus saat refactoring.",
									"_key": "p2-c3"
								}
